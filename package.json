{
  "name": "jantamedicare",
  "version": "1.0.0",
  "private": true,
  "description": "Janta Medicare \u2014 monorepo: frontend (Cloudflare), backend worker + health (Railway), Supabase, tests.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cd apps/frontend && next dev --hostname 0.0.0.0 --port 8080",
    "build": "npm run build --workspace @jm/frontend",
    "build:dev": "npm run build:dev --workspace @jm/frontend",
    "build:cf": "npm run build:cf --workspace @jm/frontend",
    "start": "npm run start --workspace @jm/frontend",
    "lint": "npm run lint --workspace @jm/frontend",
    "typecheck": "npm run typecheck --workspace @jm/frontend",
    "worker": "npm start --workspace @jm/backend",
    "health": "npm start --workspace @jm/health",
    "test:smoke": "npm run test:smoke --workspace @jm/tests",
    "test:e2e": "npm run test:e2e --workspace @jm/tests",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@parcel/watcher-win32-x64": "^2.6.0",
    "@swc/core-win32-x64-msvc": "^1.15.47",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
